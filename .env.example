APP_NAME=Jarvis File Service
APP_VERSION=0.1.0
API_PREFIX=/api/v1

DATABASE_URL=postgresql://jarvis:jarvis@localhost:5433/jarvis_files

# Must match jarvis-backend's INTERNAL_API_KEY — shared secret that proves a
# request actually came from jarvis-backend. This service is never reachable
# from the frontend/ingress, same posture as jarvis-conversation-service.
INTERNAL_API_KEY=changeme-dev-only

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=jarvis
MINIO_SECRET_KEY=jarvis12345
MINIO_BUCKET=jarvis-files
MINIO_SECURE=false

# Not wired up until phase 3 (embeddings + search_files) — see
# ~/.claude/plans/cosmic-drifting-pinwheel.md
QDRANT_URL=http://localhost:6333
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
